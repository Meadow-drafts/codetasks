{
  "name": "codetasks",
  "displayName": "CodeTasks",
  "description": "Turn code TODOs into structured, trackable tasks.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codetasks.openWorkspace",
        "title": "Open Task Workspace",
        "icon": "$(table)"
      },
      {
        "command": "codetasks.updateTaskStatus",
        "title": "CodeTasks: Change Status"
      },
      {
        "command": "codetasks.openTaskDetails",
        "title": "CodeTasks: Open Task Details"
      },
      {
        "command": "codetasks.markTaskDone",
        "title": "CodeTasks: Mark Task Done"
      },
      {
        "command": "codetasks.archiveTask",
        "title": "CodeTasks: Archive Task"
      },
      {
        "command": "codetasks.refreshTasks",
        "title": "CodeTasks: Refresh Tasks"
      },
      {
        "command": "codetasks.openArchivedTasks",
        "title": "CodeTasks: Open Archived Tasks"
      },
      {
        "command": "codetasks.restoreTask",
        "title": "CodeTasks: Restore Task"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codetasks",
          "title": "CodeTasks",
          "icon": "resources/codetasks.svg"
        }
      ]
    },
    "views": {
      "codetasks": [
        {
          "id": "codetasks.taskView",
          "name": "Tasks"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codetasks.openWorkspace",
          "when": "view == codetasks.taskView",
          "group": "navigation"
        },
        {
          "command": "codetasks.openArchivedTasks",
          "when": "view == codetasks.taskView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "codetasks.openWorkspace",
          "when": "view == codetasks.taskView && viewItem == workspaceRoot",
          "group": "codetasks"
        },
        {
          "command": "codetasks.openArchivedTasks",
          "when": "view == codetasks.taskView && viewItem == archiveRoot",
          "group": "codetasks@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
